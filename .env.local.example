# Local Fashion development. Copy to .env.local and fill secrets.

NODE_ENV=development
PORT=3000
WORKER_HEALTH_PORT=3001

DATABASE_URL=postgres://stylique:stylique@localhost:5432/stylique
REDIS_URL=redis://localhost:6379

SHOPIFY_API_KEY=cd23507550c3446a48f041df8fb44f0d
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,write_script_tags
SHOPIFY_APP_PROXY_SUBPATH=stylique
SHOPIFY_DEV_STORE_DOMAIN=stylique-fashion-test.myshopify.com

SESSION_SECRET=
APP_ENCRYPTION_KEY=
MIRA_EVENT_BRIDGE_SECRET=
STYLIQUE_INTERNAL_SECRET=
PLATFORM_JWT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

STORAGE_PATH=/tmp/stylique
CREATIVE_ENABLED=0
VTO_ENABLED=0
TRYON_FALLBACK_PROVIDER=gemini-image
