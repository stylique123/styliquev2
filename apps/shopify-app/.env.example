# fashion/apps/shopify-app/.env.example
# Copy to .env at the repo root (or this directory) and fill in every value
# marked REQUIRED before deploying to production.
# Values marked OPTIONAL degrade gracefully — the feature is disabled or
# falls back to a stub when the var is absent.
#
# Generate secrets: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Port the Express server listens on. Fly.io / Railway inject this automatically.
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED — Postgres connection string.
# Local dev default: postgres://stylique:stylique@localhost:5432/stylique
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/stylique

# ── Redis ─────────────────────────────────────────────────────────────────────
# REQUIRED — used by BullMQ job queues and rate-limiting.
REDIS_URL=redis://HOST:6379

# ── Session ───────────────────────────────────────────────────────────────────
# REQUIRED — random 32-byte hex string. Rotate immediately if compromised.
# openssl rand -hex 32
SESSION_SECRET=

# ── Shopify ───────────────────────────────────────────────────────────────────
# REQUIRED — from your Shopify Partner dashboard → App → API credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# REQUIRED — public HTTPS URL of the deployed app (used for OAuth callback).
# Dev: your Cloudflare tunnel URL, e.g. https://xxx.trycloudflare.com
SHOPIFY_APP_URL=https://your-app.fly.dev
SHOPIFY_SCOPES=read_products,read_product_listings,read_inventory,read_orders,write_metafields
SHOPIFY_APP_PROXY_SUBPATH=stylique

# ── Encryption ────────────────────────────────────────────────────────────────
# REQUIRED for production — 64-char hex (32 bytes).
# Encrypts accessToken and planFeaturesJson in the database.
# Without this, sensitive fields remain plaintext.
# openssl rand -hex 32
APP_ENCRYPTION_KEY=

# REQUIRED for production when apps/web forwards demo/shopper events into
# /api/mira/event. Set the same value on apps/web.
# openssl rand -hex 32
MIRA_EVENT_BRIDGE_SECRET=

# ── Internal Ops Dashboard ────────────────────────────────────────────────────
# REQUIRED to access /internal/* routes. 64-char hex.
# Share only with the Stylique ops team. Rotate quarterly.
# openssl rand -hex 32
STYLIQUE_INTERNAL_SECRET=

# ── Google / Vertex AI ────────────────────────────────────────────────────────
# REQUIRED for Mira chat (Gemini) and VTO rendering (Vertex).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vertex AI project used for Virtual Try-On and Gemini image generation.
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
# Path to service-account JSON key file, OR base64-encode the JSON and set
# GOOGLE_APPLICATION_CREDENTIALS_JSON (parsed at startup).
VERTEX_SERVICE_ACCOUNT_JSON=
VERTEX_VTO_MODEL_VERSION=virtual-try-on-preview-08-04
VERTEX_NANO_BANANA_MODEL=gemini-2.5-flash-image-preview

# ── AI providers (optional — stubs today) ─────────────────────────────────────
# OPTIONAL — stub providers; leave blank until Anthropic/OpenAI workers ship.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── VTO runtime config ────────────────────────────────────────────────────────
# OPTIONAL — fallback provider when Vertex is not configured.
# Values: gemini-image | replicate-idm-vton | replicate-catvton
TRYON_FALLBACK_PROVIDER=gemini-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-preview-05-20
# OPTIONAL — base URL of stylique-lite-tryon FastAPI engine (local dev only).
LITE_VTO_ENDPOINT=
# OPTIONAL — local disk path for rendered images (dev only; prod uses S3).
STORAGE_PATH=./tmp/tryon
# OPTIONAL — set 1 to enable brand-install muse generation (Vertex VTO-001).
MIDAS_ENABLED=

# ── S3 / Storage ─────────────────────────────────────────────────────────────
# REQUIRED for VTO rendered images in production.
S3_TRYON_BUCKET=stylique-tryon-renders
# Days before pre-signed URLs expire.
S3_TRYON_TTL_DAYS=30
# Generic S3 config (shared with worker for catalog exports, PDF kits, etc.)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=stylique-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://stylique-assets.s3.us-east-1.amazonaws.com

# ── AWS Rekognition (image-quality pipeline Stage 2) ─────────────────────────
# OPTIONAL — Stage 1 (heuristic) always runs; Stage 2 calls Rekognition only
# when these are set. Set AWS_REKOGNITION_DISABLED=1 to skip Stage 2 even
# when keys are present (kill switch for outages / credit-burn protection).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REKOGNITION_DISABLED=

# ── Email ─────────────────────────────────────────────────────────────────────
# OPTIONAL — priority: Resend → SMTP → console.log (dev fallback).
# In dev, leave blank; the OTP prints to stdout.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# ── Observability ─────────────────────────────────────────────────────────────
# OPTIONAL — Sentry error tracking. No-op when absent.
SENTRY_DSN=

# ── Third-party AI / media (optional) ────────────────────────────────────────
FAL_API_KEY=
REPLICATE_API_TOKEN=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "false" to disable a surface at runtime (emergency kill switches).
# All default to "true" when unset (except ENABLE_CREATIVE which defaults to false).
ENABLE_VTO=true
ENABLE_CREATIVE=true
ENABLE_MIRA=true

# === PILOT FEATURE FLAGS (emergency kill switches) ===
# Set any to "false" to disable instantly: fly secrets set ENABLE_MIRA=false
ENABLE_MIRA=true
ENABLE_VTO=true
ENABLE_CREATIVE=false
ENABLE_SIZE_REC=true
ENABLE_OUTFIT_REC=true
ENABLE_BUNDLE_CART=true

# ── Next.js Web App (apps/web — if co-deployed) ───────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.fly.dev
NEXT_PUBLIC_DEMO_SHOP_HANDLE=demo
