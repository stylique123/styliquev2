{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "SHOPIFY_API_KEY",
    "SHOPIFY_API_SECRET",
    "SHOPIFY_APP_URL",
    "SHOPIFY_SCOPES",
    "SHOPIFY_APP_PROXY_SUBPATH",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "VERTEX_PROJECT_ID",
    "VERTEX_LOCATION",
    "VERTEX_SERVICE_ACCOUNT_JSON",
    "VERTEX_VTO_MODEL_VERSION",
    "VERTEX_NANO_BANANA_MODEL",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REKOGNITION_DISABLED",
    "S3_TRYON_BUCKET",
    "S3_TRYON_TTL_DAYS",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_DEMO_SHOP_HANDLE",
    "FAL_API_KEY",
    "REPLICATE_API_TOKEN",
    "RESEND_API_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "EMAIL_FROM",
    "APP_ENCRYPTION_KEY",
    "TRYON_FALLBACK_PROVIDER",
    "GEMINI_IMAGE_MODEL",
    "STORAGE_PATH",
    "MIDAS_ENABLED",
    "PLATFORM_JWT_SECRET",
    "PLATFORM_ADMIN_SECRET",
    "NEXT_PUBLIC_PLATFORM_URL"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**", "build/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] }
  }
}
