# Production Fashion runtime. Copy to .env.production in the deployment secret store.

NODE_ENV=production
PORT=3000
WORKER_HEALTH_PORT=3001

DATABASE_URL=
REDIS_URL=

SHOPIFY_API_KEY=replace_with_stylique_fashion_production_client_id
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.stylique.ai
SHOPIFY_SCOPES=read_products,read_product_listings,read_inventory,read_orders,write_products
SHOPIFY_APP_PROXY_SUBPATH=stylique

SESSION_SECRET=
APP_ENCRYPTION_KEY=
MIRA_EVENT_BRIDGE_SECRET=
STYLIQUE_INTERNAL_SECRET=
PLATFORM_JWT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

STORAGE_PATH=
S3_TRYON_BUCKET=
VERTEX_SERVICE_ACCOUNT_JSON=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
REPLICATE_API_TOKEN=
CREATIVE_ENABLED=1
VTO_ENABLED=1
