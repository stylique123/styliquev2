# Staging Fashion runtime. Copy to .env.staging in the deployment secret store.

NODE_ENV=production
PORT=3000
WORKER_HEALTH_PORT=3001

DATABASE_URL=
REDIS_URL=

SHOPIFY_API_KEY=replace_with_stylique_fashion_staging_client_id
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://staging.stylique.ai
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,write_script_tags
SHOPIFY_APP_PROXY_SUBPATH=stylique
SHOPIFY_DEV_STORE_DOMAIN=stylique-fashion-test.myshopify.com

SESSION_SECRET=
APP_ENCRYPTION_KEY=
MIRA_EVENT_BRIDGE_SECRET=
STYLIQUE_INTERNAL_SECRET=
PLATFORM_JWT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

STORAGE_PATH=
S3_TRYON_BUCKET=
VERTEX_SERVICE_ACCOUNT_JSON=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
REPLICATE_API_TOKEN=
CREATIVE_ENABLED=0
VTO_ENABLED=0
